# Copy to .env and fill in; .env is gitignored. Process environment variables also work (and take precedence).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
JUPITER_API_KEY=
SOLANA_RPC_URL=
SURFPOOL_RPC_URL=http://127.0.0.1:8899
SCRATCH_SURFPOOL_RPC_URL=http://127.0.0.1:8999
LLM_API_KEY=
JEV_API_KEY=
TRADING_WALLET_KEYPAIR_PATH=secrets/trading-keypair.json
RESEARCH_WALLET_KEYPAIR_PATH=secrets/research-keypair.json
BASE_RESEARCH_WALLET_PRIVATE_KEY=
# M6 run modes (scripts/dev.sh sets them; you can also export them yourself)
# VIBE_DISCOVERY=replay   # live = live DexScreener discovery; replay = latest runs/m3_*.json
# VIBE_RESEARCH=cache     # live = x402 research with real money; cache = already-bought cache only, never pays
# VIBE_UI_BUTTONS=1       # on-screen approve buttons (second channel)
# Mainnet real-money mode: set by `scripts/dev.ps1 -Mode mainnet` (rehearsal / live force VT_NETWORK=fork). See README "Mainnet mode".
# VT_NETWORK=mainnet
# VT_MAINNET_MAX_TRADE_USD=5     # hard per-trade ceiling in USD on mainnet (default 5)
# VT_MAINNET_MIN_SOL=0.01        # SOL kept for fees; buys are refused below it
